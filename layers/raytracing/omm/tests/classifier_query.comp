#version 460
#extension GL_EXT_ray_query : require

// Ordinary application shader: all OMM candidate filtering is injected by the
// production composer and query consumer passes after this shader is compiled.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std430) buffer Output {
    uint flags;
    uint queryIndex;
    uint mode;
    uint reserved;
    vec2 bary;
    uint visible;
    uint committed;
    uint instanceId;
    uint logicalFlags;
    uint candidateFlags;
    uint aabbOpaque;
    float hitT;
}
result;
rayQueryEXT queries[2];

void traceQuery(uint index) {
    vec3 origin = (result.mode & 1u) != 0u ? vec3(3.25, 0.25, -1.0) : vec3(result.bary, -1.0);
    if ((result.mode & 4u) != 0u) origin.x += 5.0;
    if ((result.mode & 8u) != 0u) origin.x += 7.0 + float((result.mode >> 4u) & 3u) * 2.0;
    float tmax = (result.mode & 2u) != 0u ? 1.5 : 3.0;
    rayQueryInitializeEXT(queries[index], scene, result.flags, 255u, origin, 0.0, vec3(0.0, 0.0, 1.0), tmax);
    result.visible = 0u;
    result.aabbOpaque = 9u;
    result.candidateFlags = 0xffffffffu;
    while (rayQueryProceedEXT(queries[index])) {
        result.visible++;
        result.candidateFlags = rayQueryGetRayFlagsEXT(queries[index]);
        if (rayQueryGetIntersectionTypeEXT(queries[index], false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            rayQueryConfirmIntersectionEXT(queries[index]);
        } else {
            result.aabbOpaque = uint(rayQueryGetIntersectionCandidateAABBOpaqueEXT(queries[index]));
            rayQueryGenerateIntersectionEXT(queries[index], 1.0);
        }
    }
    result.committed = rayQueryGetIntersectionTypeEXT(queries[index], true);
    result.logicalFlags = rayQueryGetRayFlagsEXT(queries[index]);
    result.instanceId = 0xffffffffu;
    result.hitT = -1.0;
    if (result.committed != gl_RayQueryCommittedIntersectionNoneEXT) {
        result.instanceId = rayQueryGetIntersectionInstanceIdEXT(queries[index], true);
        result.hitT = rayQueryGetIntersectionTEXT(queries[index], true);
    }
}

void main() { traceQuery(result.queryIndex & 1u); }
