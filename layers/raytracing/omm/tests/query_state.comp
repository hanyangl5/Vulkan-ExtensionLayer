#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std430) buffer Result { uint seed; uint values[6]; } result;
rayQueryEXT queries[2];
rayQueryEXT nested[2][2];
rayQueryEXT first;
rayQueryEXT second;

void initialize(rayQueryEXT q, uint flags) {
    rayQueryInitializeEXT(q, scene, flags, 255u, vec3(0), 0.0, vec3(0, 0, 1), 10.0);
}
uint readFlags(rayQueryEXT q) { return rayQueryGetRayFlagsEXT(q); }
uint throughHelper(rayQueryEXT q) { return readFlags(q); }
void reinitialize(rayQueryEXT q, rayQueryEXT other) {
    result.values[2] = throughHelper(q);
    initialize(q, 64u);
    result.values[3] = throughHelper(q);
    result.values[4] = throughHelper(other);
}
void main() {
    uint index = result.seed & 1u;
    initialize(first, 1u);
    initialize(second, 2u);
    // Array-element pointers passed to functions require VariablePointers.
    // This baseline uses legal direct array operations without that capability.
    rayQueryInitializeEXT(queries[index], scene, 128u, 255u, vec3(0), 0.0, vec3(0,0,1), 10.0);
    rayQueryInitializeEXT(nested[index][1], scene, 128u, 255u, vec3(0), 0.0, vec3(0,0,1), 10.0);
    result.values[0] = throughHelper(first);
    result.values[1] = rayQueryGetRayFlagsEXT(nested[index][1]);
    reinitialize(first, second);
    result.values[5] = rayQueryGetRayFlagsEXT(queries[index]);
}
