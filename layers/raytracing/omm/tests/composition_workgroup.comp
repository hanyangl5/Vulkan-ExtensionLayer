#version 460
layout(local_size_x = 4, local_size_y = 2, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Output {
    uint invocations;
    uint indexSum;
} result;
void main() {
    atomicAdd(result.invocations, 1u);
    atomicAdd(result.indexSum, gl_LocalInvocationIndex);
}
