#version 460
// Copyright 2026 The Khronos Group Inc.
// SPDX-License-Identifier: Apache-2.0
#extension GL_GOOGLE_include_directive : require
#include "native_pipeline.glsl"
layout(location=0) rayPayloadEXT OmmPayload payload;
void main() {
    OmmContext context = OmmContext(ContextAddress);
    payload.hit = 0u; payload.instanceId = 0xffffffffu; payload.marker = 0u;
    payload.t = -1.0; payload.attributes = vec2(-1.0);
    // Native traversal exposes all opacity classes to the software wrapper.
    uint nativeFlags = (context.flags & ~(1u | 2u | 64u | 128u | 1024u)) | 2u;
    vec3 origin = vec3(context.mode == 2u ? 3.25 : 0.25, 0.25, -1.0);
    float tmax = context.mode == 1u || context.mode >= 3u ? 1.5 : 3.0;
    uint hitOffset = context.mode == 3u ? 2u : context.mode == 4u ? 3u : 0u;
    traceRayEXT(accelerationStructureEXT(context.scene), nativeFlags, 255u, hitOffset, 0u, 0u,
                origin, 0.0, vec3(0,0,1), tmax, 0);
    context.hit = payload.hit; context.instanceId = payload.instanceId;
    context.payloadMarker = payload.marker; context.hitT = payload.t;
    context.attributeU = payload.attributes.x; context.attributeV = payload.attributes.y;
}
