#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=1) in;
layout(buffer_reference,std430,buffer_reference_align=4) buffer Words { uint w[]; };
layout(push_constant,std430) uniform Publish { uint64_t root, body, capacity, status; uint kind, reserved; } p;
uint r32(uint64_t a,uint o) { return Words(a+uint64_t(o)).w[0]; }
uint64_t r64(uint64_t a,uint o) { return uint64_t(r32(a,o))|uint64_t(r32(a,o+4u))<<32u; }
void w32(uint o,uint v) { Words(p.root+uint64_t(o)).w[0]=v; }
void w64(uint o,uint64_t v) { w32(o,uint(v)); w32(o+4u,uint(v>>32u)); }
void main() {
    // Invalidate even when GPU validation failed; stale metadata must never
    // classify a newly built native AS.
    for(uint i=0u;i<16u;++i) w32(i*4u,0u);
    if(r32(p.status,0u)!=0u || r32(p.body,0u)!=0x424d4d4fu || r32(p.body,4u)!=1u ||
       r32(p.body,8u)!=p.kind || r32(p.body,52u)!=0u) return;
    uint64_t activeBytes=r64(p.body,16u), capacity=r64(p.body,24u);
    if(activeBytes<64ul || activeBytes>capacity || capacity>p.capacity || (capacity&15ul)!=0ul) return;
    w32(0u,0x434d4d4fu); w32(4u,1u); w32(8u,p.kind);
    w64(16u,p.body); w64(24u,capacity); w64(32u,r64(p.body,56u)); w32(12u,1u);
}
