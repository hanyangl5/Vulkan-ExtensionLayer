#version 460
#include "vkrt_bvh_preamble.h"
#include "vk_bvh_defines.h"
#define VK_USED_BUILD_FLAGS 0
#include "vk_bvh_helpers.h"
layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Init { hploc_init_args args; } pc;
void main() {
    uint64_t index = vkrt_build_global_id(64);
    if (index < pc.args.range_count)
        DEREF(REF(uint32_t)(pc.args.ranges + index * uint64_t(4))) = 0xffffffffu;
}
