#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require
#ifdef VKRT_SOURCE_MEMORY_MODEL
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model
#endif
layout(set=0,binding=0,std430) buffer Output { uvec4 values[]; } outputData;
layout(set=0,binding=1) uniform accelerationStructureEXT scene;
layout(push_constant) uniform Push { uint bias; } pc;
layout(location=0) rayPayloadEXT uint payload;

void main() {
    uint id=gl_LaunchIDEXT.x;
    uint hit=id&1u, miss=hit^1u;
    rayQueryEXT queries[2];
    rayQueryInitializeEXT(queries[hit],scene,gl_RayFlagsNoOpaqueEXT,255,
                         vec3(0,0,-1),0.0,vec3(0,0,1),10.0);
    rayQueryInitializeEXT(queries[miss],scene,gl_RayFlagsNoOpaqueEXT,255,
                         vec3(4,0,-1),0.0,vec3(0,0,1),10.0);
    bool candidate=rayQueryProceedEXT(queries[hit]);
    payload=5;
#ifdef VKRT_SOURCE_MEMORY_MODEL
    memoryBarrier(gl_ScopeShaderCallEXT, gl_StorageSemanticsBuffer,
                  gl_SemanticsRelease | gl_SemanticsMakeAvailable);
#endif
    // Preserve one candidate and one not-yet-traversed query across TraceRay.
    traceRayEXT(scene,gl_RayFlagsOpaqueEXT,255,0,0,0,
                vec3(hit==0u?0.0:4.0,0,-1),0.0,vec3(0,0,1),10.0,0);
#ifdef VKRT_SOURCE_MEMORY_MODEL
    memoryBarrier(gl_ScopeShaderCallEXT, gl_StorageSemanticsBuffer,
                  gl_SemanticsAcquire | gl_SemanticsMakeVisible);
#endif
    bool valid=candidate;
    if (candidate) {
        valid=valid && rayQueryGetIntersectionTypeEXT(queries[hit],false)==gl_RayQueryCandidateIntersectionTriangleEXT;
        valid=valid && rayQueryGetIntersectionTEXT(queries[hit],false)==1.0;
        rayQueryConfirmIntersectionEXT(queries[hit]);
    }
    while (rayQueryProceedEXT(queries[hit])) rayQueryConfirmIntersectionEXT(queries[hit]);
    while (rayQueryProceedEXT(queries[miss])) rayQueryConfirmIntersectionEXT(queries[miss]);
    valid=valid && rayQueryGetIntersectionTypeEXT(queries[hit],true)==gl_RayQueryCommittedIntersectionTriangleEXT;
    valid=valid && rayQueryGetIntersectionTypeEXT(queries[miss],true)==gl_RayQueryCommittedIntersectionNoneEXT;
    // Reinitialization must not retain the previous committed intersection.
    rayQueryInitializeEXT(queries[hit],scene,gl_RayFlagsOpaqueEXT,255,
                         vec3(4,0,-1),0.0,vec3(0,0,1),10.0);
    while (rayQueryProceedEXT(queries[hit])) rayQueryConfirmIntersectionEXT(queries[hit]);
    valid=valid && rayQueryGetIntersectionTypeEXT(queries[hit],true)==gl_RayQueryCommittedIntersectionNoneEXT;
    outputData.values[id]=uvec4(valid?payload+pc.bias:0xbad00badu,gl_LaunchSizeEXT.x,id,0u);
}
