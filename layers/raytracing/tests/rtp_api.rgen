#version 460
#extension GL_EXT_ray_tracing : require
layout(set=0,binding=0,std430) buffer Output { uvec4 values[]; } outputData;
layout(set=0,binding=1) uniform accelerationStructureEXT scene;
layout(push_constant) uniform Push { uint bias; } pc;
layout(location=0) rayPayloadEXT uint payload;
void main() {
    uint id=gl_LaunchIDEXT.x;
    payload=5;
    traceRayEXT(scene,gl_RayFlagsOpaqueEXT,255,0,0,0,vec3((id&1u)==0u?0.0:4.0,0,-1),0.0,vec3(0,0,1),10.0,0);
    outputData.values[id]=uvec4(payload+pc.bias,gl_LaunchSizeEXT.x,id,0u);
}
