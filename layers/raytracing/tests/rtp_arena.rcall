#version 460
#extension GL_EXT_ray_tracing : require
struct CallData { uint value; uint id; uint depth; };
layout(location = 0) callableDataInEXT CallData incoming;
layout(location = 1) callableDataEXT CallData nested;
void main() {
    if (incoming.depth == 0) {
        nested = incoming;
        nested.depth = 1;
        executeCallableEXT(0, 1);
        incoming.value = nested.value + 7u;
    } else {
        incoming.value = incoming.value * 33u + incoming.id * 17u + 0x13579u;
    }
}
