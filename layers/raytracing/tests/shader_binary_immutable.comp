#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Output { uint value; } result;
layout(set=0,binding=3) uniform sampler2D sourceImage;
layout(push_constant,std430) uniform Push { uint64_t scene; uint runQuery; uint bias; } pc;
void main() {
    uint hit = 0;
    if (pc.runQuery != 0) {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, accelerationStructureEXT(pc.scene), 0, 255,
            vec3(0,0,-1), 0, vec3(0,0,1), 10);
        while (rayQueryProceedEXT(query)) {}
        hit = rayQueryGetIntersectionTypeEXT(query,true);
    }
    // The image is black. Immutable CLAMP_TO_BORDER + opaque WHITE yields 255.
    result.value = uint(textureLod(sourceImage,vec2(-1),0).r*255.0+0.5)+pc.bias+hit;
}
