#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
#include "rtp_physical_interfaces_common.glsl"
layout(location = 0) callableDataInEXT Transfer incomingData;
layout(location = 1) callableDataEXT Transfer outgoingData;
void main() {
    if (incomingData.depth == 0u) {
        SourceData preserved = incomingData.chosen;
        outgoingData = incomingData;
        outgoingData.depth = 1u;
        executeCallableEXT(0u, 1);
        incomingData = outgoingData;
        preserved.v[incomingData.index + 5u] += 37u;
        incomingData.total += 29u;
    } else {
        incomingData.groups[1].refs[0].v[incomingData.index + 3u] += 11u;
        incomingData.groups[1].refs[1].v[incomingData.index + 3u] += 13u;
        SourceData first = incomingData.groups[0].refs[0];
        incomingData.groups[0].refs[0] = incomingData.groups[0].refs[1];
        incomingData.groups[0].refs[1] = first;
        incomingData.chosen = incomingData.groups[0].refs[0];
        incomingData.groups[1].refs[0] = incomingData.chosen;
        incomingData.total += 17u;
    }
}
