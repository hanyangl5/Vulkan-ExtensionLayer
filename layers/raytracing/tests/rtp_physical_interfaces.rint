#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
#include "rtp_physical_interfaces_common.glsl"
hitAttributeEXT PointerPack attributes;
void main() {
    // Conservative AABB candidates may still reach this shader for miss rays.
    if (sourceInvocation() % 3u == 0u) return;
    SourceRecord record = SourceRecords(sourcePush.records).rec[sourceInvocation()];
    attributes.refs[0] = record.a;
    attributes.refs[1] = record.b;
    attributes.tag = 1u;
    attributes.pad = 0x44444444u;
    bool first = reportIntersectionEXT(2.0, 33u);
    attributes.refs[0] = record.b;
    attributes.refs[1] = record.a;
    attributes.tag = 2u;
    bool second = reportIntersectionEXT(1.0, 34u);
    // The final source attribute value must not replace the committed report.
    attributes.refs[0] = record.a;
    attributes.refs[1] = record.a;
    attributes.tag = 99u;
    record.a.v[record.index + 1u] += uint(first) * 3u;
    record.b.v[record.index + 1u] += uint(second) * 5u;
}
