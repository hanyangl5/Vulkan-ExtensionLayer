#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=1) in;
layout(constant_id=7) const uint saved=37;
layout(set=0,binding=0,std430) buffer Output { uint value; } result;
layout(push_constant,std430) uniform Push { uvec2 address; uint query; uint bias; } pc;
void main() {
    uint value=saved+pc.bias;
    // Keep genuine RQ code live in the module. The cross-profile dispatch
    // deliberately uses the no-query path, without any foreign AS value.
    if(pc.query!=0) {
        rayQueryEXT ray;
        rayQueryInitializeEXT(ray,accelerationStructureEXT(uint64_t(pc.address.x)|(uint64_t(pc.address.y)<<32)),
            gl_RayFlagsOpaqueEXT,255,vec3(0,0,-1),0,vec3(0,0,1),10);
        while(rayQueryProceedEXT(ray)) {}
        value+=rayQueryGetIntersectionTypeEXT(ray,true);
    }
    result.value=value;
}
