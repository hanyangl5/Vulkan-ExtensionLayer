#version 460
#extension GL_EXT_ray_tracing : require
layout(constant_id=23) const uint staticCount=1;
layout(constant_id=24) const uint pushWords=64;
layout(constant_id=25) const uint dynamicCount=16;
layout(set=31,binding=0) uniform accelerationStructureEXT scenes[16];
layout(set=31,binding=1,std430) buffer StaticBuffer { uint value; } staticData[staticCount];
layout(set=31,binding=2,std430) buffer DynamicBuffer { uint value; } dynamicData[dynamicCount];
layout(push_constant,std430) uniform Push { uint word[pushWords]; } pc;
layout(location=0) rayPayloadEXT uint payload;
void main() {
    payload=3;
    traceRayEXT(scenes[pc.word[0]],gl_RayFlagsOpaqueEXT,255,0,0,0,vec3(0,0,-1),0.0,vec3(0,0,1),10.0,0);
    uint previous=staticData[pc.word[1]].value;
    dynamicData[pc.word[2]].value=payload+previous+pc.word[pc.word[3]];
    staticData[pc.word[1]].value=123;
}
