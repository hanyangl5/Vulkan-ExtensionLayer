{
   "file_format_version": "1.2.1",
   "layer": {
      "name": "VK_LAYER_VKRT_SOFTWARE_RAY_QUERY",
      "type": "GLOBAL",
      "library_path": "@library_path@",
      "api_version": "1.3.0",
      "implementation_version": "1",
      "description": "Software ray-query layer: GPU BVH build (Mesa BVHIR) + in-shader BVH traversal replacing VK_KHR_acceleration_structure and VK_KHR_ray_query.",
      "functions": {
         "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
      },
      "enable_environment": {
         "ENABLE_VKRT_SOFTWARE_RAY_QUERY": "1"
      },
      "disable_environment": {
         "DISABLE_VKRT_SOFTWARE_RAY_QUERY": "1"
      }
   }
}
