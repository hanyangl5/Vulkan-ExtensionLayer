/* SPDX-License-Identifier: MIT
 *
 * rq_user.comp - input for the SPIR-V lowering test.
 *
 * Deliberately mirrors the ray-query surface the validation samples use
 * (super_resolution / ray_queries / mobile_nerf_rayquery):
 *   - OpTypeAccelerationStructureKHR descriptor
 *   - rayQueryEXT local
 *   - Initialize + Proceed loop + candidate inspect/Confirm
 *   - committed queries for Type / PrimitiveIndex / Barycentrics / T
 *   - TerminateOnFirstHit shadow ray
 */

#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;

layout(push_constant) uniform Push {
   vec3  origin;
   vec3  direction;
   uint  frame;
} pc;

layout(set = 0, binding = 1, std430) buffer Out {
   uint  committed_type;
   uint  primitive_index;
   vec2  barycentrics;
   float t;
   uint  shadow_hit;
   uint  candidates;
} outb;

void
main()
{
   /* --- closest-hit query with candidate/confirm (the alpha-test path) */
   rayQueryEXT q;
   rayQueryInitializeEXT(q, topLevelAS,
                         gl_RayFlagsNoneEXT, 0xFFu,
                         pc.origin, 0.001, pc.direction, 10000.0);

   uint cands = 0;
   while (rayQueryProceedEXT(q)) {
      if (rayQueryGetIntersectionTypeEXT(q, false) ==
          gl_RayQueryCandidateIntersectionTriangleEXT) {
         cands++;
         /* Accept every candidate -- mirrors accept_hit() returning true. */
         rayQueryConfirmIntersectionEXT(q);
      }
   }

   outb.candidates = cands;
   if (rayQueryGetIntersectionTypeEXT(q, true) ==
       gl_RayQueryCommittedIntersectionTriangleEXT) {
      outb.committed_type  = 1u;
      outb.primitive_index = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
      outb.barycentrics    = rayQueryGetIntersectionBarycentricsEXT(q, true);
      outb.t               = rayQueryGetIntersectionTEXT(q, true);
   } else {
      outb.committed_type  = 0u;
      outb.primitive_index = 0xFFFFFFFFu;
      outb.barycentrics    = vec2(0.0);
      outb.t               = -1.0;
   }

   /* --- shadow ray: TerminateOnFirstHit + single Proceed (occlusion) */
   rayQueryEXT s;
   rayQueryInitializeEXT(s, topLevelAS,
                         gl_RayFlagsTerminateOnFirstHitEXT |
                             gl_RayFlagsOpaqueEXT,
                         0xFFu,
                         pc.origin, 0.001, pc.direction, 10000.0);
   rayQueryProceedEXT(s);
   outb.shadow_hit =
      (rayQueryGetIntersectionTypeEXT(s, true) !=
       gl_RayQueryCommittedIntersectionNoneEXT) ? 1u : 0u;
}
