#version 460
#include "sw_ray_query.glsl"

layout(local_size_x = 1) in;
layout(set = 0, binding = 1, std430) buffer Results { uvec4 values[]; } result;
layout(set = 0, binding = 2, std430) readonly buffer Cases { uvec4 values[]; } input_cases;
layout(push_constant, scalar) uniform Push { uint64_t nodes; uint64_t tlas; uint64_t deep_tlas; uint64_t resume_tlas; } pc;

void main()
{
   uint index = gl_GlobalInvocationID.x;
   if (index >= 30u) {
      sw_ray_query_state q;
      q.as_address = index == 30u ? pc.deep_tlas : pc.resume_tlas;
      q.ray = sw_setup_ray(vec3(0,0,10), vec3(0,0,-1));
      q.ray_flags = 0u;
      q.cull_mask = 255u;
      q.tmin = 0.0;
      q.tclosest = 100.0;
      sw_ray_query_initialize_data(q);
      uint candidates = 0u, observed = 0u;
      while (sw_ray_query_proceed(q) && candidates < 10u) {
         uint primitive = q.candidate.primitive_index;
         observed = index == 30u ? primitive : observed | (1u << primitive);
         /* Reject the first candidate; then Confirm changes the interval
          * after Proceed already saved its next sibling cursor. */
         if (index == 31u && candidates != 0u) sw_ray_query_confirm(q);
         ++candidates;
      }
      result.values[index] = index == 30u ? uvec4(candidates, observed, 0u, 0u) :
         uvec4(candidates, observed, q.committed.primitive_index, floatBitsToUint(q.tclosest));
      return;
   }
   uvec4 test_case = input_cases.values[index];
   sw_ray_query_state q;
   q.as_address = pc.tlas;
   q.ray_flags = test_case.y;
   q.current_instance = (3u << 30u);
   q.candidate.opaque = false;
   bool proceed = sw_test_aabb_leaf(q, (2u << 30u) | test_case.x, test_case.y | test_case.z,
                                   99u, 88u, pc.nodes);
   uint classification = proceed ? uint(sw_get_intersection_candidate_aabb_opaque(q)) : 2u;

   /* Distinct nodes and nonzero high bytes catch a wrong intersection
    * selector, offset calculation or failure to mask instance flags. */
   q.candidate.instance_node = (3u << 30u);
   q.committed.instance_node = (3u << 30u) | 1u;
   q.want_committed = 0u;
   uint candidate_sbt = uint(sw_get_intersection_instance_sbt_offset(q));
   q.want_committed = 1u;
   uint committed_sbt = uint(sw_get_intersection_instance_sbt_offset(q));
   result.values[index] = uvec4(uint(proceed), classification, candidate_sbt, committed_sbt);
}
