/* SPDX-License-Identifier: MIT
 *
 * Compile-check harness for sw_ray_query.glsl.
 *
 * The traversal is a function library that the layer injects into user
 * shaders at vkCreateShaderModule time (design doc section 4/11). It has
 * no entry point of its own, so this .comp exists only to force a real
 * glslc run over it and catch type / layout errors early.
 *
 * Build:
 *   glslc -fshader-stage=compute --target-env=vulkan1.2 \
 *         -I <layer>/bvh -I <layer>/traversal \
 *         sw_ray_query_compile_check.comp -o /tmp/sw.comp.spv
 */

#version 460

#include "sw_ray_query.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint64_t kAsAddress = 0;

layout(push_constant) uniform Push {
   vec3  origin;
   float tmin;
   vec3  direction;
   float tmax;
   uint  flags;
   uint  cull_mask;
} pc;

layout(set = 0, binding = 0, std430) buffer Out {
   uint  hit_type;
   uint  primitive_index;
   vec2  barycentrics;
   float t;
   uint  hit_kind;
   uint  proceed_count;
} outb;

void
main()
{
   sw_ray_query_state q;
   sw_ray_query_initialize(q, uint64_t(kAsAddress),
                           pc.flags, pc.cull_mask,
                           pc.origin, pc.tmin,
                           pc.direction, pc.tmax);

   uint proceeds = 0;
   while (sw_ray_query_proceed(q)) {
      proceeds++;
      if (sw_get_intersection_type(q, false) == SW_INTERSECTION_TRIANGLE_CANDIDATE) {
         /* Exercise the candidate surface the samples use. */
         uint prim = uint(sw_get_intersection_primitive_index(q, false));
         vec2  b   = sw_get_intersection_barycentrics(q, false);
         if ((prim + uint(b.x)) != 0xFFFFFFFFu)
            sw_ray_query_confirm(q);
      }
   }

   outb.proceed_count    = proceeds;
   outb.hit_type         = sw_get_intersection_type(q, true);
   outb.primitive_index  = uint(sw_get_intersection_primitive_index(q, true));
   outb.barycentrics     = sw_get_intersection_barycentrics(q, true);
   outb.t                = sw_get_intersection_t(q, true);
   outb.hit_kind         = sw_get_intersection_hit_kind(q, true);
}
